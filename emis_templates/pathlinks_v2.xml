<?xml version="1.0" encoding="UTF-8"?>
<Protocol xmlns="http://www.emis-online.com/protocol" Name="PathLinks_V2_Stable" Description="Clinical Decision Support" Version="2.0">
  <Author Name="PathLinks" />
  <Trigger Type="ResultFiling" />
  <Logic>
    <Rule Name="Hyperkalaemia">
      <Condition>
        <Match TestCode="K" Operator="GreaterThanOrEqual" Value="6.0" />
      </Condition>
      <Action Type="DisplayPrompt">
        <Text><![CDATA[Potassium >= 6.0 alert.]]></Text>
      </Action>
    </Rule>
  </Logic>
</Protocol>
