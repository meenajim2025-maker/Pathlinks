                    }
                }
            },
            {
                "name": "Faecal Calprotectin",
                "unit": "µg/g",
                "ranges": {
                    "all": {
                        "max": 50
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "> 250: High risk of IBD. Refer."
                        ]
                    }
                }
            }
        ]
    },
    {
        "category": "Lipids & Cardiac",
        "tests": [
            {
                "name": "Total Cholesterol",
                "unit": "mmol/L",
                "ranges": {
                    "all": {
                        "max": 5.0
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "Calculate QRISK3 score. If >10% offer Statins."
                        ]
                    }
                }
            },
            {
                "name": "LDL Cholesterol",
                "unit": "mmol/L",
                "ranges": {
                    "all": {
                        "max": 3.0
                    }
                }
            },
            {
                "name": "HDL Cholesterol",
                "unit": "mmol/L",
                "ranges": {
                    "male": {
                        "min": 1.0
                    },
                    "female": {
                        "min": 1.2
                    }
                },
                "guidance": {
                    "low": {
                        "actions": [
                            "Low HDL is a cardiovascular risk factor. Advise lifestyle/exercise."
                        ]
                    }
                }
            },
            {
                "name": "Non-HDL Cholesterol",
                "unit": "mmol/L",
                "ranges": {
                    "all": {
                        "max": 4.0
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "Better predictor of CVD risk than LDL. Target < 4.0 (primary) or < 2.6 (secondary)."
                        ]
                    }
                }
            },
            {
                "name": "Triglycerides",
                "unit": "mmol/L",
                "ranges": {
                    "all": {
                        "max": 1.7
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "If >10 mmol/L: Risk of acute pancreatitis. Urgent referral.",
                            "If 2.3 - 10: Optimise diabetes/alcohol before repeat."
                        ]
                    }
                }
            }
        ]
    },
    {
        "category": "Diabetes & HbA1c",
        "tests": [
            {
                "name": "HbA1c",
                "unit": "mmol/mol",
                "ranges": {
                    "all": {
                        "min": 20,
                        "max": 41
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "42 - 47 mmol/mol: PREDIABETES / High Risk. ACTION: Refer to National Diabetes Prevention Programme (NDPP). Lifestyle advice (Diet/Exercise). Re-test annually.",
                            "48 - 57 mmol/mol: TYPE 2 DIABETES diagnosed. ACTION: Lifestyle advice. Offer Metformin. Target 48 mmol/mol.",
                            "SGLT2 Trigger: If CVD risk >10%, Heart Failure, or CKD: Add SGLT2 inhibitor (e.g. Dapagliflozin) early.",
                            "58 - 74 mmol/mol: SUBOPTIMAL CONTROL. ACTION: Intensify to dual therapy (Metformin + SGLT2i / DPP4i / Pioglitazone / SU). Target 53 mmol/mol.",
                            "> 75 mmol/mol: POOR CONTROL. ACTION: Review adherence. Consider triple therapy or GLP-1 RA if BMI >35. If symptomatic (Os/Us), consider Insulin referral.",
                            "Note: Relaxation of targets may be appropriate for elderly/frail patients."
                        ]
                    }
                }
            }
        ]
    },
    {
        "category": "Tumour Markers",
        "tests": [
            {
                "name": "PSA",
                "unit": "ng/mL",
                "ranges": {
                    "age_40_49": {
                        "max": 2.5
                    },
                    "age_50_59": {
                        "max": 3.5
                    },
                    "age_60_69": {
                        "max": 4.5
                    },
                    "age_70_79": {
                        "max": 6.5
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "Exclude UTI/Exercise. If above age-threshold, 2WW referral."
                        ]
                    }
                }
            },
            {
                "name": "CA125",
                "unit": "U/mL",
                "ranges": {
                    "all": {
                        "max": 35
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "CA125 >= 35: Urgent Pelvic US for Ovarian cancer (NICE CG122)."
                        ]
                    }
                }
            },
            {
                "name": "CA19-9",
                "unit": "U/mL",
                "ranges": {
                    "all": {
                        "max": 37
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "If jaundice/weight loss, 2WW Pancreatic pathway (Urgent CT)."
                        ]
                    }
                }
            },
            {
                "name": "CEA",
                "unit": "µg/L",
                "ranges": {
                    "all": {
                        "max": 3
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "Not for screening. Used for monitoring post-resection colorectal cancer."
                        ]
                    }
                }
            },
            {
                "name": "AFP",
                "unit": "kU/L",
                "ranges": {
                    "all": {
                        "max": 10
                    }
                },
                "guidance": {
                    "high": {
                        "actions": [
                            "Raised in Liver (HCC) or Testicular cancer. Request Urgent US."
                        ]
                    }
                }
            }
        ]
    }
]