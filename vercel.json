{
  "version": 2,
  "public": true,
  "buildCommand": "echo 'Static site — data is pre-generated and committed; no build step.'",
  "installCommand": "echo skip",
  "framework": null,
  "outputDirectory": "app",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
