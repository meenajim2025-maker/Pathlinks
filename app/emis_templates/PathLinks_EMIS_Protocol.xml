<?xml version="1.0" encoding="UTF-8"?>
<Protocol xmlns="http://www.emis-online.com/protocol" Name="PathLinks_Test_v2.2" Description="PathLinks CDS" Version="2.2">
  <Author Name="PathLinks" />
  <Trigger Type="ResultFiling" />
  <Logic>
    <Rule Name="K_Alert">
      <Condition>
        <Match TestCode="K" Operator="GreaterThan" Value="6.0" />
      </Condition>
      <Action Type="DisplayPrompt">
        <Text><![CDATA[Potassium > 6.0]]></Text>
      </Action>
    </Rule>
  </Logic>
</Protocol>
